{
    "manifest_version": 3,
    "name": "Web Document Preview",
    "version": "0.1.0",
    "description": "WEB上の文書をブラウザ内でプレビューする拡張機能",

    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],

    "background": {
        "service_worker": "background.js"
    },
    "content_scripts":[
        {
            "matches":[
                "http://*/*",
                "https://*/*"
            ],
            "js":["content.js"],
            "run_at":"document_start"
        }
    ]
}